<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- No packages are used, so there is nothing to fetch and no feed to talk to. Clearing the
       fallback folders also ignores stale machine-wide ones (for example a removed Visual Studio). -->
  <packageSources>
    <clear />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
