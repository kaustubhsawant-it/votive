<Project Sdk="Microsoft.NET.Sdk">

  <!-- Prototype for AGEN-34: a native Windows pill + tray icon that reads ~/.votive/events.
       No package references on purpose: nothing here may bring in a network stack or a web engine. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VotiveWin</AssemblyName>
    <RootNamespace>Votive.Win</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>false</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <!-- Implicit usings would put System.Net.Http in scope of every file. Nothing here may use it, so it is not even imported. -->
  <ItemGroup>
    <Using Remove="System.Net.Http" />
  </ItemGroup>

</Project>
