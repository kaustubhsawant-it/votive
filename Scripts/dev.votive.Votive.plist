<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.votive.Votive</string>
    <key>ProgramArguments</key>
    <array>
        <string>__APP_BINARY__</string>
    </array>
    <!-- Start at login, and restart only if it crashes (exits with an error). A normal Quit (exit 0)
         stays quit until the next login; with a plain KeepAlive=true launchd would bring it straight back. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- GUI/menu-bar app: only load in an Aqua login session. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
</dict>
</plist>
